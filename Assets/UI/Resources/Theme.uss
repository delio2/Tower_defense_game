/* tokens:begin — generated by Tools/tokens_to_uss.py from Tools/design/tokens.json; do not edit by hand */
:root {
    --sky-far: #3b3f7a;
    --sky-mid: #1c2050;
    --sky-near: #0e1030;
    --arena-ring: #3b3f72;
    --surface-glass: #1e2248;
    --surface-raised: #272b5a;
    --line: #4a4e7e;
    --ivory: #f3e9d7;
    --ivory-muted: #c4bec4;
    --ivory-faint: #8e8a9e;
    --ink: #141630;
    --teal: #5cc8c0;
    --teal-deep: #2f7f7a;
    --gold: #e9b872;
    --gold-deep: #a87a3e;
    --mint: #9ad9a1;
    --mint-deep: #5e9e68;
    --coral: #f07a6a;
    --coral-deep: #a8463c;
    --rose: #e8709a;
    --ally: #c9c2ff;
    --glow: #ffd9a8;
    --silver: #b8bcd8;
    --focus-ring: #f3e9d7;
    --night: #141630;
    --glass: #1e2248;
    --glass-border: #4a4e7e;
    --ivory-60: #c4bec4;
    --ivory-40: #8e8a9e;
    --space-1: 12px;
    --space-2: 24px;
    --space-3: 36px;
    --space-4: 48px;
    --space-6: 72px;
    --space-8: 96px;
    --space-12: 144px;
    --radius-chip: 24px;
    --radius-card: 48px;
    --radius-button: 72px;
    --radius-sheet: 96px;
    --radius-round: 2997px;
    --size-touch: 144px;
    --size-primary: 192px;
    --size-pulse: 264px;
    --size-card-w: 234px;
    --size-card-h: 324px;
    --type-number-hero: 168px;
    --type-number-xl: 96px;
    --type-number: 60px;
    --type-number-sm: 42px;
    --type-title: 72px;
    --type-heading: 54px;
    --type-body: 48px;
    --type-label: 45px;
    --type-caption: 36px;
    --gutter: 48px;
    --font-display: 96px;
    --font-title: 72px;
    --font-number: 60px;
    --font-body: 48px;
    --font-caption: 36px;
    --press-tint: rgba(243, 233, 215, 0.1);
    --fill-tint: rgba(243, 233, 215, 0.18);
    --border-uncommon: rgba(184, 188, 216, 0.6);
    --scrim: rgba(20, 22, 48, 0.6);
}

/* High contrast: the design system's fourth theme, same measures, stronger separation. */
.theme-contrast {
    --sky-far: #1a1c3a;
    --sky-mid: #0c0d22;
    --sky-near: #07081a;
    --arena-ring: #4a4d8a;
    --surface-glass: #0b0c1e;
    --surface-raised: #14163a;
    --line: #9a9cc8;
    --ivory: #fff8ec;
    --ivory-muted: #e6e0e6;
    --ivory-faint: #c9c4cc;
    --ink: #000010;
    --teal: #7fe8e0;
    --teal-deep: #3fa39c;
    --gold: #ffd08a;
    --gold-deep: #c8944c;
    --mint: #b4f0bb;
    --mint-deep: #76be80;
    --coral: #ff9a8a;
    --coral-deep: #c85a4e;
    --rose: #ff78a8;
    --ally: #e0dcff;
    --glow: #ffffff;
    --silver: #dcdff0;
    --focus-ring: #ffffff;
    --night: #000010;
    --glass: #0b0c1e;
    --glass-border: #9a9cc8;
    --ivory-60: #e6e0e6;
    --ivory-40: #c9c4cc;
}

/* Large text: one step up on every size the interface reads from (docs/09 section 6). */
.text-large {
    --font-display: 120px;
    --font-title: 90px;
    --font-number: 75px;
    --font-body: 60px;
    --font-caption: 45px;
}
/* tokens:end */

/*
 * Typefaces (docs/09 §5, design system "Dusk Garden"): Nunito writes the words, Outfit writes the numbers the
 * player tracks. The three weights are baked from the variable fonts by TowerDefense -> Content -> Build font
 * assets; Nunito falls back to Outfit for the few signs it does not draw (the arrow of the drag preview).
 */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--ivory);
    -unity-font-style: normal;
    -unity-font-definition: url("/Assets/UI/Fonts/Nunito-SemiBold.asset");
}

/* Titles, button labels and anything small enough to need the extra weight. */
.caption,
.btn,
.card__name,
.sheet__title,
.sheet__subtitle,
.option-row__label,
.summary__hint,
.toast {
    -unity-font-definition: url("/Assets/UI/Fonts/Nunito-ExtraBold.asset");
}

/* Numbers: top bar, costs, damage, previews, totals and the run-end title. */
.top-number,
.floating-number,
.card__cost,
.preview-effect,
.pulse__label,
.summary__title,
.summary__line,
.overlay__title {
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
}

.numbers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.floating-number {
    position: absolute;
    font-size: var(--font-caption);
    color: var(--ivory);
    -unity-text-align: middle-center;
    width: 300px;
    height: 60px;
}

.floating-number--big {
    font-size: var(--font-number);
    color: var(--gold);
}

/* Top bar: three numbers, nothing else (docs/09 §2.2) */
.top-bar {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 60px;
    height: 120px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.top-number {
    font-size: var(--font-number);
    color: var(--ivory);
}

.top-number--warning {
    /* Low Integrity never turns red (coral belongs to enemies, docs/03 A4): the arc around the Core says it. */
    color: var(--ivory);
}

/*
 * Wave progress: a hairline under the top bar, not a bar with a number (docs/09 §0 rule 5 — the wave already says
 * "7/18"; this only answers "how much of it is left"). Only during a wave.
 */
.wave-progress {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 186px;
    height: 3px;
    background-color: var(--line);
}

.wave-progress__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--ivory-40);
}

/*
 * Integrity arc: a ring around the Core, so health is read where the eye already is (docs/09 §2.2). Drawn in panel
 * space by HudView, because a horizontal ring in the arena flattens to nothing under a 35-degree camera.
 */
.core-arc {
    position: absolute;
    width: 300px;
    height: 300px;
}

/*
 * Edge markers (docs/06 2.5-B6): an elite or a Guardian that is off screen leaves a mark on the edge it is behind,
 * so a threat is never a surprise. Small, faint and rose — the colour reserved for elites (docs/03 A4).
 */
.edge-marker {
    position: absolute;
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background-color: var(--rose);
    opacity: 0.75;
}

/* Guardian: the name announces it, then the strip stays as its health bar. */
.guardian {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 210px;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.guardian__name {
    font-size: var(--font-title);
    color: var(--ivory);
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
    margin-bottom: 12px;
}

.guardian__track {
    width: 100%;
    height: 12px;
    border-radius: 6px;
    background-color: var(--surface-raised);
}

.guardian__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: 6px;
    background-color: var(--rose);
}

/*
 * Inspector (docs/09 §2.2): tap a module or an enemy during a wave and a small read-only bubble appears above it
 * for a couple of seconds. It never blocks the arena: pointer events pass straight through.
 */
.inspector {
    position: absolute;
    width: 480px;
    padding: 18px 24px;
    border-radius: var(--radius-card);
    background-color: var(--surface-glass);
    border-width: 3px;
    border-color: var(--line);
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.inspector__title {
    font-size: var(--font-body);
    color: var(--ivory);
    -unity-font-definition: url("/Assets/UI/Fonts/Nunito-ExtraBold.asset");
}

.inspector__body {
    font-size: var(--font-caption);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
}

.toast {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 200px;
    font-size: var(--font-body);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.toast--visible {
    opacity: 1;
}

/* Bottom third (docs/09 §0 rule 1) */
.bottom-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 700px;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
    padding-bottom: 36px;
    justify-content: flex-end;
}

.row {
    flex-direction: row;
    justify-content: space-between;
}

.column {
    flex-direction: column;
    justify-content: space-between;
}

/*
 * Wave preview (docs/09 §2.3): what is coming, as shapes rather than a sentence — a chip per enemy kind with its
 * count, "new" on a kind never seen before, and a compass showing which sides they enter from.
 */
.wave-preview {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.compass {
    width: 84px;
    height: 84px;
    margin-right: 18px;
    flex-shrink: 0;
}

.threats {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.threat {
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding: 0 18px;
    margin-right: 12px;
    border-radius: var(--radius-chip);
    background-color: var(--surface-glass);
    border-width: 3px;
    border-color: var(--line);
}

.threat--new {
    border-color: var(--gold);
}

.threat__icon {
    width: 36px;
    height: 36px;
    margin-right: 9px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--coral);
}

.threat__icon--enemy { background-image: url("/Assets/UI/Icons/enemy.png"); }
.threat__icon--swarm { background-image: url("/Assets/UI/Icons/swarm.png"); }
.threat__icon--dash { background-image: url("/Assets/UI/Icons/dash.png"); }
.threat__icon--split { background-image: url("/Assets/UI/Icons/split.png"); }
.threat__icon--shield { background-image: url("/Assets/UI/Icons/shield.png"); }
.threat__icon--guardian { background-image: url("/Assets/UI/Icons/guardian.png"); }

.threat__icon--elite {
    -unity-background-image-tint-color: var(--rose);
}

.threat__count {
    font-size: var(--font-caption);
    color: var(--ivory);
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
}

.caption {
    font-size: var(--font-caption);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.glass {
    background-color: var(--glass);
    border-color: var(--glass-border);
    border-width: 3px;
    border-radius: var(--radius-card);
}

/* Buttons: primary solid ivory, secondary outline (docs/09 §4.1). No hover/active flashing. */
.btn {
    height: 168px;
    border-radius: var(--radius-button);
    font-size: var(--font-body);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0 24px;
    border-width: 3px;
    transition-property: scale, opacity;
    transition-duration: 0.15s;
}

.btn:active {
    scale: 0.96 0.96;
}

.btn:disabled {
    opacity: 0.4;
}

.btn-primary {
    background-color: var(--ivory);
    color: var(--night);
    border-color: var(--ivory);
}

.btn-secondary {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ivory);
    border-color: var(--ivory-40);
}

.btn-secondary:active {
    background-color: var(--press-tint);
}

.btn--breathing {
    /* "Breathing" replaces red dots: one element per screen (docs/09 §4.2). Driven from code (scale). */
}

/*
 * Drag feedback (docs/03 B3, docs/09 §2.3): while a module is being dragged, what it would change appears as a
 * bubble under the top bar — away from the finger, and where the eye already checks the numbers.
 */
.preview-effect {
    position: absolute;
    left: 240px;
    right: 240px;
    top: 228px;
    padding: 12px 0;
    border-radius: var(--radius-button);
    background-color: var(--surface-glass);
    border-width: 3px;
    border-color: var(--line);
    font-size: var(--font-body);
    color: var(--ivory);
    -unity-text-align: middle-center;
}

.sell-zone {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 240px;
    height: 150px;
    border-radius: var(--radius-card);
    border-width: 3px;
    border-color: var(--line);
    background-color: var(--surface-glass);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.sell-zone--hot {
    border-color: var(--ivory);
    background-color: var(--surface-raised);
}

.sell-zone__label {
    font-size: var(--font-body);
    color: var(--ivory);
}

/* The ghost is the module itself, lifted above the finger (docs/03 B3), not a card-shaped box. */
.drag-ghost__art {
    width: 150px;
    height: 132px;
    -unity-background-scale-mode: scale-to-fit;
}

.drag-ghost {
    position: absolute;
    width: 240px;
    height: 216px;
    border-radius: var(--radius-card);
    border-width: 3px;
    border-color: var(--teal);
    background-color: var(--surface-glass);
    justify-content: center;
    align-items: center;
    scale: 1.1 1.1;
    transition-property: left, top;
    transition-duration: 0s;
}

.drag-ghost--returning {
    transition-property: left, top;
    transition-duration: 0.25s;
}

.card--source {
    opacity: 0.35;
}

/* Offer cards (docs/09 §2.3) */
.cards {
    /* v2 cards: render, name, reach dots, cost. No sentence, so they are shorter again (docs/09 §2.3). */
    height: 420px;
    margin-bottom: 24px;
    margin-right: -24px;
}

.card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
    padding: 18px;
    justify-content: space-between;
    align-items: center;
    border-radius: var(--radius-card);
    background-color: var(--glass);
    border-color: var(--glass-border);
    border-width: 3px;
    transition-property: translate, scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/*
 * Cards arrive when the shop opens, one 40 ms after the other (docs/09 section 4.5): the shop assembles itself
 * rather than snapping into place. The camera move between shop and wave is the other half of the same beat.
 */
.card--entering {
    translate: 0 90px;
    opacity: 0;
}

.card--selected {
    border-color: var(--teal);
    translate: 0 -36px;
    scale: 1.05 1.05;
}

.card--disabled {
    opacity: 0.6;
}

.card--sold {
    opacity: 0;
}

.card--uncommon {
    border-color: var(--border-uncommon);
}

.card--rare {
    border-color: var(--gold);
}

.card__icon {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin-top: 6px;
}

.card__icon--weapon { background-color: var(--teal); }
.card__icon--booster { background-color: var(--gold); }
.card__icon--economy { background-color: var(--mint); }

/* Rendered module art (docs/09 §2.3 card anatomy): the model is the main element of the card. */
/* One height for every render, so name, dots and cost line up across the four cards. */
.card__icon--art {
    width: 168px;
    height: 150px;
    flex-shrink: 0;
    margin-top: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.card__name {
    /* Starting size; HudView steps it down until the name fits the card it is on (any screen shape). */
    font-size: 36px;
    color: var(--ivory);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Category glyph in the corner: colour AND shape say what a module is (docs/03 A4). */
.card__glyph {
    position: absolute;
    top: 18px;
    left: 18px;
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
}

.card__glyph--weapon {
    background-image: url("/Assets/UI/Icons/cat-weapon.png");
    -unity-background-image-tint-color: var(--teal);
}

.card__glyph--booster {
    background-image: url("/Assets/UI/Icons/cat-booster.png");
    -unity-background-image-tint-color: var(--gold);
}

.card__glyph--economy {
    background-image: url("/Assets/UI/Icons/cat-economy.png");
    -unity-background-image-tint-color: var(--mint);
}

/* Reach dots: how many range bands the module covers from the ring (D32). */
.card__reach {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.card__dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin: 0 6px;
    border-width: 3px;
    border-color: var(--ivory-40);
}

.card__dot--on {
    background-color: var(--teal);
    border-color: var(--teal);
}

.card__cost-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.icon--small {
    width: 36px;
    height: 36px;
    margin-right: 9px;
}

.card__cost {
    font-size: var(--font-number);
    color: var(--ivory);
}

.card__cost--unaffordable {
    color: var(--coral);
}

/* Merge badge: the drawn merge icon and the level it would reach. "Merge L2" as words overran the card corner. */
.card__badge {
    position: absolute;
    top: 12px;
    right: 18px;
    flex-direction: row;
    align-items: center;
}

.card__badge-icon {
    width: 33px;
    height: 33px;
    margin-right: 6px;
    background-image: url("/Assets/UI/Icons/merge.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
}

.card__badge-level {
    font-size: 30px;
    color: var(--gold);
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
}

.actions {
    height: 168px;
    margin-right: -24px;
}

/* Icon buttons: a drawn glyph and, where there is a price, the number. The primary action keeps its word. */
.btn--compact {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 0.7;
}

.btn__icon {
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ivory);
}

.btn__icon--undo { background-image: url("/Assets/UI/Icons/undo.png"); }
.btn__icon--reroll { background-image: url("/Assets/UI/Icons/reroll.png"); }
.btn__icon--slot { background-image: url("/Assets/UI/Icons/slot.png"); }

.btn__value {
    font-size: var(--font-body);
    color: var(--ivory);
    margin-left: 12px;
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
}

.actions > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
}

.module-panel {
    height: 372px;
    margin-bottom: 24px;
}

.module-info {
    flex-grow: 2;
    flex-basis: 0;
    font-size: var(--font-caption);
    color: var(--ivory);
    white-space: normal;
    -unity-text-align: middle-left;
    padding: 18px;
}

.module-panel > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 24px;
    height: auto;
}

/* Wave controls: Pulse 60% width x 360 px, speed and pause beside it */
.wave-controls {
    height: 360px;
}

/*
 * Pulse (docs/09 §2.2): the cooldown is a ring that fills, drawn by HudView; when it is ready the button turns
 * ivory and a halo breathes at its edge (0.3 -> 0.6 -> 0.3 over 2 s, never a flash).
 */
.pulse {
    width: 60%;
    height: 360px;
    border-radius: var(--radius-button);
    background-color: var(--surface-raised);
    border-color: var(--ivory-40);
    border-width: 3px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.pulse__halo {
    position: absolute;
    left: -12px;
    right: -12px;
    top: -12px;
    bottom: -12px;
    border-radius: var(--radius-button);
    border-width: 3px;
    border-color: var(--ivory);
    opacity: 0;
}

.pulse__ring {
    width: 108px;
    height: 108px;
    margin-right: 24px;
}

.pulse--ready {
    background-color: var(--ivory);
    border-color: var(--ivory);
}


.pulse__label {
    font-size: var(--font-title);
    color: var(--ivory);
    -unity-text-align: middle-center;
}

.pulse--ready > .pulse__label {
    color: var(--night);
}

.side-buttons {
    width: 36%;
    height: 360px;
}

/* Round buttons, as the mockup has them: speed keeps its "2x", pause is a drawn icon. */
.side-buttons > .btn {
    width: 168px;
    height: 168px;
    align-self: flex-end;
    border-radius: 84px;
    padding: 0;
}

.btn--icon {
    background-image: url("/Assets/UI/Icons/pause.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ivory);
    background-size: 60px 60px;
}

.btn--icon-resume {
    background-image: url("/Assets/UI/Icons/next.png");
}

.top-group {
    flex-direction: row;
    align-items: center;
}

/*
 * Icons are drawings, never glyphs: device fonts lack the symbols, and the design system's line set reads better
 * at this size. Tools/icons_to_png.py renders docs/art/icons/*.svg white on transparency, so each use tints its
 * own copy. 54 px = 18 dp, the size the top bar's numbers sit beside.
 */
.icon {
    width: 54px;
    height: 54px;
    margin-right: 15px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ivory);
}

.icon--integrity {
    background-image: url("/Assets/UI/Icons/integrity.png");
}

.icon--credits {
    background-image: url("/Assets/UI/Icons/credits.png");
    -unity-background-image-tint-color: var(--gold);
}

/* Options sheet (docs/09 §2.7): one list, immediate effect */
.gear {
    width: 96px;
    height: 96px;
    margin: 0;
    padding: 0;
    border-radius: 48px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/UI/Icons/options.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ivory-40);
}

.sheet {
    width: 900px;
    padding: 48px;
    background-color: var(--surface-glass);
}

.sheet__title {
    font-size: var(--font-title);
    color: var(--ivory);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 132px;
}

.option-row__label {
    font-size: var(--font-body);
    color: var(--ivory);
}

.option-row__control {
    margin: 0;
}

.option-row__slider {
    width: 360px;
    margin: 0;
}

.option-row__button {
    width: 300px;
    height: 108px;
    font-size: var(--font-caption);
}

.sheet__close {
    margin-top: 36px;
}

.sheet__subtitle {
    font-size: var(--font-caption);
    color: var(--ivory-40);
    -unity-text-align: middle-center;
    margin-top: 24px;
}

.option-row {
    height: 108px;
}

/* End-of-wave summary (docs/03 B4): progressive counting, tap anywhere to skip */
.summary {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 260px;
}

/*
 * Damage share (docs/06 2.5-D1): one bar per module that did something this wave, so the shop that follows is a
 * decision made on evidence rather than on a feeling. Fed by the simulation's per-module counter.
 */
.summary__shares {
    width: 100%;
    margin-top: 24px;
}

.share {
    flex-direction: row;
    align-items: center;
    height: 48px;
}

.share__name {
    width: 240px;
    font-size: var(--font-caption);
    color: var(--ivory-60);
}

.share__track {
    flex-grow: 1;
    height: 12px;
    border-radius: 6px;
    background-color: var(--surface-raised);
}

.share__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-radius: 6px;
    background-color: var(--teal);
}

.summary__panel {
    width: 720px;
    padding: 48px;
    align-items: center;
    background-color: var(--surface-glass);
}

.summary__title {
    font-size: var(--font-title);
    color: var(--ivory);
    margin-bottom: 24px;
}

.summary__line {
    font-size: var(--font-body);
    color: var(--ivory-60);
    margin-bottom: 12px;
}

.summary__credits {
    color: var(--gold);
}

.summary__hint {
    font-size: 28px;
    color: var(--ivory-40);
    margin-top: 24px;
}

/* Run end overlay (docs/09 §2.4) */
.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--scrim);
    justify-content: center;
    align-items: center;
    padding: var(--gutter);
}

/* Run end (docs/09 §2.4): what stopped the run, the totals rolling up, then what to do next. */
.stopped-by {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.stopped-by__label {
    font-size: var(--font-body);
    color: var(--ivory-60);
}

.run-total {
    font-size: var(--font-number);
    color: var(--ivory);
    -unity-font-definition: url("/Assets/UI/Fonts/Outfit-SemiBold.asset");
    margin-bottom: 12px;
}

.run-end-actions {
    width: 100%;
    margin-top: 24px;
}

.run-end-actions > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
}

.overlay__title {
    font-size: var(--font-display);
    color: var(--ivory);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.overlay__stats {
    font-size: var(--font-body);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 72px;
}

.overlay > .btn {
    width: 60%;
}

.hidden {
    display: none;
}

/* Default-theme controls sized for the thumb (48 dp = 144 px) */
.option-row__control .unity-toggle__checkmark {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    border-width: 3px;
    border-color: var(--ivory-40);
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--ivory);
}

.option-row__slider .unity-base-slider__tracker {
    height: 12px;
    border-radius: 6px;
    background-color: var(--ivory-40);
}

.option-row__slider .unity-base-slider__dragger {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    margin-top: -24px;
    background-color: var(--ivory);
    border-width: 0;
}
