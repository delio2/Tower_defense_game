/* tokens:begin — generated by Tools/tokens_to_uss.py from Tools/design/tokens.json; do not edit by hand */
:root {
    --sky-far: #3b3f7a;
    --sky-mid: #1c2050;
    --sky-near: #0e1030;
    --arena-ring: #3b3f72;
    --surface-glass: #1e2248;
    --surface-raised: #272b5a;
    --line: #4a4e7e;
    --ivory: #f3e9d7;
    --ivory-muted: #c4bec4;
    --ivory-faint: #8e8a9e;
    --ink: #141630;
    --teal: #5cc8c0;
    --teal-deep: #2f7f7a;
    --gold: #e9b872;
    --gold-deep: #a87a3e;
    --mint: #9ad9a1;
    --mint-deep: #5e9e68;
    --coral: #f07a6a;
    --coral-deep: #a8463c;
    --rose: #e8709a;
    --ally: #c9c2ff;
    --glow: #ffd9a8;
    --silver: #b8bcd8;
    --focus-ring: #f3e9d7;
    --night: #141630;
    --glass: #1e2248;
    --glass-border: #4a4e7e;
    --ivory-60: #c4bec4;
    --ivory-40: #8e8a9e;
    --space-1: 12px;
    --space-2: 24px;
    --space-3: 36px;
    --space-4: 48px;
    --space-6: 72px;
    --space-8: 96px;
    --space-12: 144px;
    --radius-chip: 24px;
    --radius-card: 48px;
    --radius-button: 72px;
    --radius-sheet: 96px;
    --radius-round: 2997px;
    --size-touch: 144px;
    --size-primary: 192px;
    --size-pulse: 264px;
    --size-card-w: 234px;
    --size-card-h: 324px;
    --type-number-hero: 168px;
    --type-number-xl: 96px;
    --type-number: 60px;
    --type-number-sm: 42px;
    --type-title: 72px;
    --type-heading: 54px;
    --type-body: 48px;
    --type-label: 45px;
    --type-caption: 36px;
    --gutter: 48px;
    --font-display: 96px;
    --font-title: 72px;
    --font-number: 60px;
    --font-body: 48px;
    --font-caption: 36px;
}
/* tokens:end */

.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--ivory);
    -unity-font-style: normal;
}

.numbers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.floating-number {
    position: absolute;
    font-size: var(--font-caption);
    color: var(--ivory);
    -unity-text-align: middle-center;
    width: 300px;
    height: 60px;
}

.floating-number--big {
    font-size: var(--font-number);
    color: var(--gold);
}

/* Top bar: three numbers, nothing else (docs/09 §2.2) */
.top-bar {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 60px;
    height: 120px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.top-number {
    font-size: var(--font-number);
    color: var(--ivory);
}

.top-number--warning {
    /* Low Integrity never turns red (coral belongs to enemies, docs/03 A4): the arc around the Core says it. */
    color: var(--ivory);
}

.toast {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 200px;
    font-size: var(--font-body);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.toast--visible {
    opacity: 1;
}

/* Bottom third (docs/09 §0 rule 1) */
.bottom-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 700px;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
    padding-bottom: 36px;
    justify-content: flex-end;
}

.row {
    flex-direction: row;
    justify-content: space-between;
}

.column {
    flex-direction: column;
    justify-content: space-between;
}

.caption {
    font-size: var(--font-caption);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.glass {
    background-color: var(--glass);
    border-color: var(--glass-border);
    border-width: 3px;
    border-radius: var(--radius-card);
}

/* Buttons: primary solid ivory, secondary outline (docs/09 §4.1). No hover/active flashing. */
.btn {
    height: 168px;
    border-radius: var(--radius-button);
    font-size: var(--font-body);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0 24px;
    border-width: 3px;
    transition-property: scale, opacity;
    transition-duration: 0.15s;
}

.btn:active {
    scale: 0.96 0.96;
}

.btn:disabled {
    opacity: 0.4;
}

.btn-primary {
    background-color: var(--ivory);
    color: var(--night);
    border-color: var(--ivory);
}

.btn-secondary {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ivory);
    border-color: var(--ivory-40);
}

.btn-secondary:active {
    background-color: rgba(243, 233, 215, 0.1);
}

.btn--breathing {
    /* "Breathing" replaces red dots: one element per screen (docs/09 §4.2). Driven from code (scale). */
}

/* Drag feedback (docs/03 B3, docs/09 §2.3): preview at the top, Sell zone only while dragging a module */
.preview-effect {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: -120px;
    font-size: var(--font-body);
    color: var(--ivory);
    -unity-text-align: middle-center;
}

.sell-zone {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 240px;
    height: 150px;
    border-radius: var(--radius-card);
    border-width: 3px;
    border-color: var(--line);
    background-color: var(--surface-glass);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.sell-zone--hot {
    border-color: var(--ivory);
    background-color: var(--surface-raised);
}

.sell-zone__label {
    font-size: var(--font-body);
    color: var(--ivory);
}

.drag-ghost {
    position: absolute;
    width: 240px;
    height: 200px;
    border-radius: var(--radius-card);
    border-width: 3px;
    border-color: var(--teal);
    background-color: #1A1D40;
    justify-content: center;
    align-items: center;
    scale: 1.1 1.1;
    transition-property: left, top;
    transition-duration: 0s;
}

.drag-ghost--returning {
    transition-property: left, top;
    transition-duration: 0.25s;
}

.card--source {
    opacity: 0.35;
}

/* Offer cards (docs/09 §2.3) */
.cards {
    height: 432px;
    margin-bottom: 24px;
    margin-right: -24px;
}

.card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
    padding: 18px;
    justify-content: space-between;
    align-items: center;
    border-radius: var(--radius-card);
    background-color: var(--glass);
    border-color: var(--glass-border);
    border-width: 3px;
    transition-property: translate, scale, opacity;
    transition-duration: 0.12s;
}

.card--selected {
    border-color: var(--teal);
    translate: 0 -36px;
    scale: 1.05 1.05;
}

.card--disabled {
    opacity: 0.6;
}

.card--sold {
    opacity: 0;
}

.card--uncommon {
    border-color: rgba(200, 205, 220, 0.6);
}

.card--rare {
    border-color: var(--gold);
}

.card__icon {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin-top: 6px;
}

.card__icon--weapon { background-color: var(--teal); }
.card__icon--booster { background-color: var(--gold); }
.card__icon--economy { background-color: var(--mint); }

/* Rendered module art (docs/09 §2.3 card anatomy): the model is the main element of the card. */
.card__icon--art {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    margin-top: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.card__name {
    font-size: var(--font-body);
    color: var(--ivory);
    -unity-text-align: middle-center;
}

.card__effect {
    font-size: 26px;
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    white-space: normal;
}

.card__cost {
    font-size: var(--font-number);
    color: var(--ivory);
}

.card__cost--unaffordable {
    color: var(--coral);
}

.card__badge {
    position: absolute;
    top: 12px;
    right: 18px;
    font-size: 30px;
    color: var(--gold);
}

.actions {
    height: 168px;
    margin-right: -24px;
}

.actions > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
}

.module-panel {
    height: 372px;
    margin-bottom: 24px;
}

.module-info {
    flex-grow: 2;
    flex-basis: 0;
    font-size: var(--font-caption);
    color: var(--ivory);
    white-space: normal;
    -unity-text-align: middle-left;
    padding: 18px;
}

.module-panel > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 24px;
    height: auto;
}

/* Wave controls: Pulse 60% width x 360 px, speed and pause beside it */
.wave-controls {
    height: 360px;
}

.pulse {
    width: 60%;
    height: 360px;
    border-radius: var(--radius-button);
    background-color: #2B2F5A;
    border-color: var(--ivory-40);
    border-width: 3px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.pulse--ready {
    background-color: var(--ivory);
    border-color: var(--ivory);
}

.pulse__fill {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    height: 0;
    background-color: rgba(243, 233, 215, 0.18);
}

.pulse__label {
    font-size: var(--font-title);
    color: var(--ivory);
    -unity-text-align: middle-center;
}

.pulse--ready > .pulse__label {
    color: var(--night);
}

.side-buttons {
    width: 36%;
    height: 360px;
}

.side-buttons > .btn {
    height: 168px;
}

.credits-group {
    flex-direction: row;
    align-items: center;
}

/* Credits icon drawn, not a glyph: fonts on the device lack the symbols */
.credit-icon {
    width: 36px;
    height: 36px;
    margin-right: 18px;
    background-color: var(--gold);
    rotate: 45deg;
    border-radius: 6px;
}

/* Options sheet (docs/09 §2.7): one list, immediate effect */
.gear {
    width: 96px;
    height: 96px;
    margin: 0;
    padding: 0;
    border-radius: 48px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ivory-40);
    font-size: var(--font-number);
    -unity-text-align: middle-center;
}

.sheet {
    width: 900px;
    padding: 48px;
    background-color: #1A1D40;
}

.sheet__title {
    font-size: var(--font-title);
    color: var(--ivory);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 132px;
}

.option-row__label {
    font-size: var(--font-body);
    color: var(--ivory);
}

.option-row__control {
    margin: 0;
}

.option-row__slider {
    width: 360px;
    margin: 0;
}

.option-row__button {
    width: 300px;
    height: 108px;
    font-size: var(--font-caption);
}

.sheet__close {
    margin-top: 36px;
}

.sheet__subtitle {
    font-size: var(--font-caption);
    color: var(--ivory-40);
    -unity-text-align: middle-center;
    margin-top: 24px;
}

.option-row {
    height: 108px;
}

/* End-of-wave summary (docs/03 B4): progressive counting, tap anywhere to skip */
.summary {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 260px;
}

.summary__panel {
    width: 720px;
    padding: 48px;
    align-items: center;
    background-color: #1A1D40;
}

.summary__title {
    font-size: var(--font-title);
    color: var(--ivory);
    margin-bottom: 24px;
}

.summary__line {
    font-size: var(--font-body);
    color: var(--ivory-60);
    margin-bottom: 12px;
}

.summary__credits {
    color: var(--gold);
}

.summary__hint {
    font-size: 28px;
    color: var(--ivory-40);
    margin-top: 24px;
}

/* Run end overlay (docs/09 §2.4) */
.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(20, 22, 48, 0.6);
    justify-content: center;
    align-items: center;
    padding: var(--gutter);
}

.overlay__title {
    font-size: var(--font-display);
    color: var(--ivory);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.overlay__stats {
    font-size: var(--font-body);
    color: var(--ivory-60);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 72px;
}

.overlay > .btn {
    width: 60%;
}

.hidden {
    display: none;
}

/* Default-theme controls sized for the thumb (48 dp = 144 px) */
.option-row__control .unity-toggle__checkmark {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    border-width: 3px;
    border-color: var(--ivory-40);
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--ivory);
}

.option-row__slider .unity-base-slider__tracker {
    height: 12px;
    border-radius: 6px;
    background-color: var(--ivory-40);
}

.option-row__slider .unity-base-slider__dragger {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    margin-top: -24px;
    background-color: var(--ivory);
    border-width: 0;
}
